# Copy to .env and fill in. .env is git-ignored: never commit real secrets.
# The application reads these values from environment variables only.
#   Docker:  docker compose up -d --build
#   Shell:   set -a; . ./.env; set +a; ./mvnw -pl connector-bootstrap -am spring-boot:run

# --- PostgreSQL ---
# docker compose creates the database with this password. Secret.
DB_PASSWORD=
# Only needed when running the app outside docker compose:
# DB_URL=jdbc:postgresql://localhost:5432/tgconnector
# DB_USER=tgconnector

# --- Access for Claude (OAuth) ---
# GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps → New OAuth App),
# Authorization callback URL: <public URL>/login/oauth2/code/github. Secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids allowed to sign in (https://api.github.com/users/<login> → "id").
# Preferred over logins: a renamed login can be taken by someone else.
GITHUB_ALLOWED_IDS=
# Comma-separated GitHub logins, checked only when GITHUB_ALLOWED_IDS is empty.
GITHUB_ALLOWED_LOGINS=
# Client credentials Claude uses; enter the same values in claude.ai when adding the connector. Secret.
MCP_OAUTH_CLIENT_ID=claude
MCP_OAUTH_CLIENT_SECRET=
# Encrypts the token signing key and issued tokens in the database: a random string of 32+ characters.
# Secret. Changing it later revokes the stored signing key and all issued tokens (Claude has to reconnect).
CONNECTOR_ENCRYPTION_KEY=
# Public base URL (on Railway taken from RAILWAY_PUBLIC_DOMAIN automatically).
# CONNECTOR_PUBLIC_URL=https://connector.example.com

# --- Telegram Bot API (optional) ---
# Token from @BotFather. Secret.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Register chats automatically when the bot gets a message from them.
TELEGRAM_BOT_AUTO_REGISTER_CHATS=false

# --- HTTP ---
PORT=8080
