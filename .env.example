# Copy to .env and fill in. .env is git-ignored: never commit real secrets.
# The application reads these values from environment variables only.
#   Docker:  docker run --env-file .env -p 8080:8080 tg-connector
#   Shell:   set -a; . ./.env; set +a; ./mvnw -pl connector-bootstrap -am spring-boot:run

# --- Telegram Bot API (optional) ---
# Token from @BotFather. Secret.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Register chats automatically when the bot gets a message from them.
TELEGRAM_BOT_AUTO_REGISTER_CHATS=false

# --- HTTP ---
PORT=8080
